# demo.instockornot.club — Let's Encrypt automatic. One gate key (on the slide). Full options for everyone.
#   /            the demo (wall.html)        /gpu/        the GPU dials (slider page)
#   /monitor/    Netdata on the host          (the /presenter/ door was retired 2026-09-26 — one login, full options for everyone)
demo.instockornot.club {
	encode zstd gzip
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 3
		}
	}
	# The gate: one key, no usernames (app/gate.py). Everything except the gate page itself asks ctxdemo first;
	# a page without the cookie is sent to /gate, a fetch gets 401. The key is the one line in /srv/data/gate/key on the host.
	# (Back to the password popup: put `basic_auth { import /etc/caddy/auth/htpasswd }` here instead; the htpasswd file is still on the box.)
	@gated not path /gate /api/gate /shell /shell/*
	forward_auth @gated ctxdemo:8200 {
		uri /api/gate/check
	}
	# /shell/* — the NFCU lab terminals. One container per named user. The sign-in is the wall's own (/gate, name + password):
	# Caddy asks ctxdemo /api/shell/check, which answers 204 + X-Lab-User only for a signed-in lab user (never for the shared key),
	# and each user's snippet routes on that header to their own container. No sign-in: a page goes to /gate, anything else gets 401.
	# Users and routes are generated by /srv/projects/nfcu-shell/bin/add-shell-user; never hand-edit /srv/data/caddy/shell/.
	@shell path /shell /shell/*
	handle @shell {
		# route keeps this order. The client's own X-Lab-User is dropped first: only ctxdemo's answer may name the user.
		route {
			request_header -X-Lab-User
			forward_auth ctxdemo:8200 {
				uri /api/shell/check
				copy_headers X-Lab-User
			}
			import /etc/caddy/auth/shell/*.caddy
			redir /shell /shell/{http.request.header.X-Lab-User}/ 302
			redir /shell/ /shell/{http.request.header.X-Lab-User}/ 302
			respond "Not your shell." 403
		}
	}
	# handle_errors is site-level only; it fires just for a /shell/* proxy failure (the user's container is stopped).
	handle_errors {
		@down {
			path /shell/*
			expression {http.error.status_code} == 502
		}
		respond @down "Your shell is paused. Ask Simon to resume it." 503
	}
	handle_path /monitor/* {
		reverse_proxy host.docker.internal:19999
	}
	redir /gpu /gpu/ 301
	handle_path /gpu/* {
		root * /etc/caddy/conf/site/gpu
		file_server
	}
	handle {
		redir / /static/peek/wall.html 302
		reverse_proxy ctxdemo:8200 {
			header_up -X-Presenter
		}
	}
}
